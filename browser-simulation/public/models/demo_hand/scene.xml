<!--
  Einfaches Platzhalter-Modell einer Hand (nur Primitive, keine Meshes).
  Dient zum Testen der Web-Simulation, bis das MJCF-Modell der Amazing Hand eingebunden ist.
  Jeder Finger hat zwei Gelenke (Grund- und Mittelgelenk), die je ein Positions-Aktuator ansteuert.
-->
<mujoco model="demo_hand">
  <compiler angle="degree"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <default>
    <joint type="hinge" axis="1 0 0" range="0 90" damping="0.05" armature="0.001"/>
    <geom type="capsule" size="0.009" rgba="0.85 0.78 0.70 1" density="1000"/>
    <position kp="2" ctrlrange="0 1.5708"/>
  </default>

  <asset>
    <material name="floor" rgba="0.25 0.27 0.30 1"/>
    <material name="palm" rgba="0.30 0.45 0.75 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.2" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="floor"/>

    <body name="palm" pos="0 0 0.15">
      <geom name="palm" type="box" size="0.045 0.012 0.05" material="palm"/>

      <body name="index" pos="0.03 0 0.05">
        <joint name="index_mcp"/>
        <geom fromto="0 0 0 0 0 0.04"/>
        <body pos="0 0 0.04">
          <joint name="index_pip"/>
          <geom fromto="0 0 0 0 0 0.035"/>
        </body>
      </body>

      <body name="middle" pos="0.01 0 0.05">
        <joint name="middle_mcp"/>
        <geom fromto="0 0 0 0 0 0.045"/>
        <body pos="0 0 0.045">
          <joint name="middle_pip"/>
          <geom fromto="0 0 0 0 0 0.04"/>
        </body>
      </body>

      <body name="ring" pos="-0.01 0 0.05">
        <joint name="ring_mcp"/>
        <geom fromto="0 0 0 0 0 0.042"/>
        <body pos="0 0 0.042">
          <joint name="ring_pip"/>
          <geom fromto="0 0 0 0 0 0.036"/>
        </body>
      </body>

      <body name="thumb" pos="0.045 0 -0.02" euler="0 40 0">
        <joint name="thumb_mcp" axis="0 1 0" range="-30 60"/>
        <geom fromto="0 0 0 0 0 0.035" size="0.010"/>
        <body pos="0 0 0.035">
          <joint name="thumb_ip"/>
          <geom fromto="0 0 0 0 0 0.03" size="0.010"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="index_mcp" joint="index_mcp"/>
    <position name="index_pip" joint="index_pip"/>
    <position name="middle_mcp" joint="middle_mcp"/>
    <position name="middle_pip" joint="middle_pip"/>
    <position name="ring_mcp" joint="ring_mcp"/>
    <position name="ring_pip" joint="ring_pip"/>
    <position name="thumb_mcp" joint="thumb_mcp" ctrlrange="-0.5236 1.0472"/>
    <position name="thumb_ip" joint="thumb_ip"/>
  </actuator>
</mujoco>
